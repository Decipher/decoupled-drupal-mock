{
  "name": "decoupled-drupal-mock",
  "version": "1.0.0-alpha.0",
  "description": "Drupal's decoupled APIs over a fixture dump: JSON:API, Decoupled Router, menu linksets and Simple OAuth, as Drupal answers them, without Drupal.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js"
    },
    "./recorded-writes": {
      "types": "./dist/recorded-writes.d.ts",
      "import": "./dist/recorded-writes.js"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./jest": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.cjs"
    },
    "./cypress": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.cjs"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "import": "./dist/graphql.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/runner.ts --bundle --platform=node --format=cjs --target=node16 --outfile=dist/runner.cjs --log-level=warning",
    "prepack": "yarn build"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "graphql": "^17.0.2",
    "typescript": "^5.9.0"
  },
  "bin": "./dist/cli.js",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0",
    "msw": "*"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  }
}
