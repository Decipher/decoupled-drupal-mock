{
  "name": "decoupled-drupal-mock",
  "version": "1.0.0-alpha.0",
  "description": "Drupal's decoupled APIs over a fixture dump: JSON:API, Decoupled Router, menu linksets and Simple OAuth, as Drupal answers them, without Drupal.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "bin": "./dist/cli.js"
}
