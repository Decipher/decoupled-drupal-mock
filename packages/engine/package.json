{
  "name": "decoupled-drupal-mock",
  "version": "1.0.0-alpha.2",
  "description": "Drupal's decoupled APIs over a fixture dump: JSON:API, Decoupled Router, menu linksets and Simple OAuth, as Drupal answers them, without Drupal.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js"
    },
    "./recorded-writes": {
      "types": "./dist/recorded-writes.d.ts",
      "import": "./dist/recorded-writes.js"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./jest": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.cjs"
    },
    "./cypress": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && esbuild src/runner.ts --bundle --platform=node --format=cjs --target=node16 --outfile=dist/runner.cjs --define:import.meta.url=importMetaUrl --inject:import-meta-url.js --log-level=warning",
    "prepack": "yarn build"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "bin": "./dist/cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Decipher/decoupled-drupal-mock.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/Decipher/decoupled-drupal-mock#readme",
  "bugs": {
    "url": "https://github.com/Decipher/decoupled-drupal-mock/issues"
  }
}
