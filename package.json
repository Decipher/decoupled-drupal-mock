{
  "name": "decoupled-drupal-mock-workspace",
  "private": true,
  "description": "Drupal JSON:API fixtures and a mock server, built per Drupal release.",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*",
    "presets/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "crawl": "node --experimental-strip-types packages/build/src/cli.ts",
    "overlay": "node --experimental-strip-types packages/build/src/overlay-cli.ts",
    "dump:diff": "node --experimental-strip-types packages/build/src/dump-diff-cli.ts",
    "rebuild:summary": "node --experimental-strip-types packages/build/src/rebuild-summary.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "yarn lint:js && yarn lint:cspell && yarn lint:md && yarn lint:format && yarn lint:private && yarn lint:knip",
    "lint:js": "eslint .",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,ts,json,md,yml,yaml,php}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:format": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "lint:commit": "commitlint",
    "tunnel": "bash scripts/tunnel.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:audit": "yarn workspace decoupled-drupal-mock npm audit --environment production --recursive --severity high && yarn workspace decoupled-drupal-mock-umami npm audit --environment production --recursive --severity high",
    "lint:prose:install": "bash .gitlab/scripts/install-vale.sh .vale/bin .vale/styles",
    "lint:prose": "PROSE_LINT_GLOB='!{.changeset/**,presets/*/dump/**,examples/*/node_modules/**,node_modules/**,.yarn/**,packages/*/CHANGELOG.md,presets/*/CHANGELOG.md,presets/*/REBUILD.md}' VALE_BIN=\"$PWD/.vale/bin/vale\" bash .gitlab/scripts/lint-prose.sh",
    "changeset": "changeset",
    "size": "size-limit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "knip": "^6.44.1",
    "markdownlint-cli2": "^0.24.0",
    "msw": "^3.0.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "license": "GPL-2.0-or-later"
}
