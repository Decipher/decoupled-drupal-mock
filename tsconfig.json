{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "vitest.config.ts"
  ]
}
